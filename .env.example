# Copy to `.env` and fill in your GitHub OAuth App client id (public PKCE value).
# Create the app at https://github.com/settings/applications/new with callback URL
# http://127.0.0.1:3846/callback. Used by the desktop client (desktop/src-tauri).
GITHUB_OAUTH_CLIENT_ID=your_github_oauth_app_client_id
# Optional. Set to your OAuth App's client secret to use the confidential flow
# (instead of PKCE). Leave empty for PKCE.
GITHUB_OAUTH_CLIENT_SECRET=your_github_oauth_app_client_secret
# The product (brand) name shown in the desktop window title and the Web sidebar
# wordmark. Defaults to "DeepSeek Harness" when unset.
PRODUCT_NAME=DeepSeek Harness
